{
  "expo": {
    "name": "Nouri",
    "slug": "nouri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nouri",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A6B3C"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nouri.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Nouri uses your camera to identify foods from photos and scan barcodes.",
        "NSMicrophoneUsageDescription": "Nouri uses your microphone for voice food logging.",
        "NSHealthShareUsageDescription": "Nouri reads health data to sync your weight, steps, and workouts.",
        "NSHealthUpdateUsageDescription": "Nouri writes nutrition data to Apple Health.",
        "NSPhotoLibraryUsageDescription": "Nouri accesses your photos to log meals from your camera roll."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A6B3C"
      },
      "package": "com.nouri.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nouri accesses your photos to log meals."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1A6B3C"
        }
      ],
      "react-native-vision-camera"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
